# 비밀 정보와 컴퓨터별 설정이 Git 이력에 포함되지 않도록 제외합니다.

# 환경 변수 및 로컬 설정 (예제 파일에는 실제 비밀 값을 넣지 않습니다.)
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template
.envrc
*.local

# 비밀번호, 토큰 및 자격 증명
secrets/
.secrets/
credentials/
.credentials/
secrets.*
credentials.*
passwords.*
tokens.*
service-account*.json
service_account*.json
*-firebase-adminsdk-*.json
client_secret*.json

# 개인 키 및 인증서 저장소
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
.ssh/
.aws/
.azure/
.gcloud/
.config/gcloud/
.kube/
.npmrc
.pypirc
.netrc
_netrc
.git-credentials

# 실행 중 생성되는 로그 및 로컬 데이터
supabase/.temp/
*.log
logs/
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal
*.db
*.db-journal

# 운영체제 임시 파일
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.swp
*~
